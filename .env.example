# Aura connects to the Immich API only. No NAS mount is needed by Aura.
AURA_PORT=18080
AURA_DATA_DIR=./data
AURA_EVENT_INTERVAL=86400
AURA_ALBUM_INTERVAL=300
IMMICH_URL=http://immich-server:2283
IMMICH_API_KEY=
# Browser URL; blank = current hostname + IMMICH_PORT.
IMMICH_PUBLIC_URL=
IMMICH_PORT=2283

# Optional bundled official Immich deployment. Keep the verified version pinned.
IMMICH_VERSION=v3.3.4
IMMICH_UPLOAD_LOCATION=./immich/library
IMMICH_DB_DATA_LOCATION=./immich/postgres
IMMICH_DB_USERNAME=postgres
IMMICH_DB_DATABASE_NAME=immich
IMMICH_DB_PASSWORD='CHANGE_ME_RANDOM_ALPHANUMERIC'
IMMICH_ML_HF_ENDPOINT=https://huggingface.co

# Only Immich mounts the NAS, read-only.
NAS_HOST=YOUR_NAS_IP
NAS_SHARE=YOUR_PHOTO_SHARE
NAS_USER=YOUR_SMB_USER
NAS_PASSWORD='CHANGE_ME_PASSWORD'
NAS_SMB_VERSION=3.0
