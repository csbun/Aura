# Recommended: Docker mounts the NAS SMB share directly.
NAS_HOST=127.0.0.2
NAS_SHARE=CHANGE_ME_SMB_SHARE
NAS_USER=CHANGE_ME_USER
NAS_PASSWORD='CHANGE_ME_PASSWORD'
NAS_SMB_VERSION=3.0

# Used by both SMB and host-mount modes.
AURA_DATA_DIR=./data
AURA_DB_PATH=/data/aura.db
AURA_PORT=18080

# Optional Immich adapter. Leave blank until Immich is installed and an API
# key with album/asset permissions has been created.
IMMICH_URL=http://immich-server:2283
IMMICH_API_KEY=
IMMICH_PATH_PREFIX=/photos
IMMICH_VERSION=release
IMMICH_PORT=2283
IMMICH_UPLOAD_LOCATION=./immich/library
IMMICH_DB_DATA_LOCATION=./immich/postgres
IMMICH_DB_USERNAME=postgres
IMMICH_DB_DATABASE_NAME=immich
IMMICH_DB_PASSWORD='CHANGE_ME_IMMICH_DB_PASSWORD'

# Alternative mode only: if you mount SMB on the host yourself, set this and
# use docker-compose.yml without docker-compose.smb.yml.
# PHOTO_ROOT=/mnt/aura-photos
