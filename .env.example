# Only values that normally need to be supplied for an existing Immich.
# Compose provides safe defaults for ports, paths, schedules, timezone and
# database username/name. Aura connects to Immich through the official API.
IMMICH_URL=http://immich-server:2283
IMMICH_API_KEY=

# Required only when using the bundled Immich + NAS profile.
IMMICH_DB_PASSWORD='CHANGE_ME_RANDOM_ALPHANUMERIC'
NAS_HOST=YOUR_NAS_IP
NAS_SHARE=YOUR_PHOTO_SHARE
NAS_USER=YOUR_SMB_USER
NAS_PASSWORD='CHANGE_ME_PASSWORD'

# Optional overrides for an unusual deployment or a restricted network:
# AURA_PORT=18080
# AURA_DATA_DIR=./data
# IMMICH_PUBLIC_URL=
# IMMICH_ML_HF_ENDPOINT=https://huggingface.co
# Do not set a CLIP preload variable unless the exact model name is verified.
