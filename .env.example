# Immich v3.3.5. Copy this file to .env and replace the placeholder password.
IMMICH_DB_PASSWORD='CHANGE_ME_RANDOM_ALPHANUMERIC'

# Host directories for Immich external libraries. Add more numbered entries
# when needed; they appear inside Immich as /external/1, /external/2, etc.
IMMICH_EXTERNAL_LIBRARY_1=/srv/photos
# IMMICH_EXTERNAL_LIBRARY_2=/mnt/photo-archive
# IMMICH_EXTERNAL_LIBRARY_3=/mnt/phone-photos
# IMMICH_EXTERNAL_LIBRARY_4=/mnt/family-photos

# Optional overrides:
# IMMICH_VERSION=v3.3.5
# IMMICH_PORT=2283
# New installations use Docker volumes, created automatically.
# Only set these when reusing existing host directories with data:
# IMMICH_UPLOAD_LOCATION=/existing/immich/library
# IMMICH_DB_DATA_LOCATION=/existing/immich/postgres
# IMMICH_DB_USERNAME=postgres
# IMMICH_DB_DATABASE_NAME=immich
TZ=Asia/Shanghai
IMMICH_ML_HF_ENDPOINT=https://hf-mirror.com
IMMICH_GEODATA_CN_GITHUB_PROXY=https://gh-proxy.com/

# Optional full image addresses on a mirror reachable from your Docker host:
# IMMICH_GEODATA_INIT_IMAGE=docker.1ms.run/library/alpine:3.21
# IMMICH_REDIS_IMAGE=docker.1ms.run/valkey/valkey:9
